{
  "title": "TAISS - Retail Data Pipeline",
  "uid": "taiss-retail",
  "tags": ["taiss", "data-quality"],
  "timezone": "browser",
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "type": "row",
      "title": "Qualite des donnees",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "type": "stat",
      "title": "Taux d acceptation",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 1 },
      "targets": [{ "expr": "taiss_acceptance_rate_percent", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 95 },
              { "color": "green", "value": 99 }
            ]
          }
        }
      },
      "options": { "colorMode": "background", "graphMode": "none", "textMode": "value" }
    },
    {
      "type": "stat",
      "title": "Lignes chargees",
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 1 },
      "targets": [{ "expr": "taiss_rows_loaded_total", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": { "mode": "fixed", "fixedColor": "green" }
        }
      },
      "options": { "colorMode": "value", "graphMode": "area" }
    },
    {
      "type": "stat",
      "title": "Lignes rejetees",
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 1 },
      "targets": [{ "expr": "taiss_rows_rejected_total", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": { "mode": "fixed", "fixedColor": "orange" }
        }
      },
      "options": { "colorMode": "value", "graphMode": "area" }
    },
    {
      "type": "stat",
      "title": "Fraicheur des donnees",
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 1 },
      "targets": [{ "expr": "taiss_data_freshness_hours", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "unit": "h",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 24 },
              { "color": "red", "value": 26 }
            ]
          }
        }
      },
      "options": { "colorMode": "background", "graphMode": "none" }
    },
    {
      "type": "piechart",
      "title": "Rejets par motif",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "targets": [
        { "expr": "taiss_rejects_by_reason", "legendFormat": "{{reason}}", "refId": "A", "instant": true }
      ],
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "values": ["value"] },
        "pieType": "donut",
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false }
      }
    },
    {
      "type": "bargauge",
      "title": "Rejets par fichier source",
      "description": "Un fichier qui concentre les rejets designe le magasin dont la caisse produit des donnees incorrectes. Seuil d alerte : 15.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "targets": [
        { "expr": "taiss_rejects_by_source_file", "legendFormat": "{{source_file}}", "refId": "A", "instant": true }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "min": 0,
          "max": 25,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "yellow", "value": null },
              { "color": "red", "value": 15 }
            ]
          }
        }
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false }
      }
    },
    {
      "type": "row",
      "title": "Activite metier",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 }
    },
    {
      "type": "stat",
      "title": "Chiffre d affaires total",
      "gridPos": { "h": 5, "w": 8, "x": 0, "y": 15 },
      "targets": [{ "expr": "taiss_total_revenue", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "unit": "locale",
          "decimals": 0,
          "color": { "mode": "fixed", "fixedColor": "blue" }
        }
      },
      "options": { "colorMode": "value", "graphMode": "area" }
    },
    {
      "type": "stat",
      "title": "Fichiers traites",
      "gridPos": { "h": 5, "w": 4, "x": 8, "y": 15 },
      "targets": [{ "expr": "taiss_files_processed_total", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 0 } },
      "options": { "colorMode": "value", "graphMode": "none" }
    },
    {
      "type": "bargauge",
      "title": "Chiffre d affaires par point de vente",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 15 },
      "targets": [
        { "expr": "taiss_revenue_by_store", "legendFormat": "{{store_name}}", "refId": "A", "instant": true }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "locale",
          "decimals": 0,
          "color": { "mode": "continuous-BlPu" }
        }
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false }
      }
    },
    {
      "type": "timeseries",
      "title": "Evolution du taux d acceptation",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 20 },
      "targets": [
        { "expr": "taiss_acceptance_rate_percent", "legendFormat": "Acceptation", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 90,
          "max": 100,
          "custom": { "fillOpacity": 15, "lineWidth": 2 }
        }
      }
    }
  ],
  "schemaVersion": 39,
  "version": 2
}